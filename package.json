{
  "name": "page-foundry",
  "version": "0.1.3",
  "description": "Portable author publishing from Obsidian notes.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production && node scripts/check-runtime.mjs",
    "release:prepare": "npm run verify && node scripts/prepare-release.mjs",
    "build:browser-smoke": "node scripts/build-browser-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:book-pdf": "node scripts/check-book-designs.mjs",
    "test:markdown-pdf": "node scripts/check-markdown-pdf.mjs",
    "lint": "eslint src --max-warnings=0",
    "verify": "npm run format:check && npm run lint && npm test && npm run build",
    "test-vault": "node --import tsx scripts/install-test-vault.mjs",
    "test-vault:guide": "node --import tsx scripts/refresh-test-guide.ts --refresh-generated-guide",
    "test-vault:fresh": "node --import tsx scripts/prepare-author-test-vault.ts --reset-selected-test-vault",
    "test-outputs": "node --import tsx scripts/generate-test-outputs.ts"
  },
  "keywords": [
    "obsidian",
    "publishing",
    "pdf",
    "epub",
    "docx",
    "typst",
    "manuscript"
  ],
  "author": "Christian Grobmeier",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "obsidian": {
      "moment": "2.31.0"
    }
  },
  "dependencies": {
    "@file-viewer/assets-typst": "3.1.2",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "docx": "9.8.1",
    "fflate": "0.8.3",
    "jszip": "3.10.2",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.2",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@codemirror/view": "6.43.13",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "22.18.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.8.7",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.0"
  }
}
